# Gemini is used for claim extraction and optional semantic adjudication.
GEMINI_API_KEY=gemini_api_key
GEMINI_MODEL=model_name

# Keep disabled by default. Deterministic verification works without this.
SEMANTIC_VERIFICATION_ENABLED=false

# Maximum number of uncertain claims sent in one Gemini adjudication request.
SEMANTIC_VERIFICATION_MAX_CLAIMS=60
